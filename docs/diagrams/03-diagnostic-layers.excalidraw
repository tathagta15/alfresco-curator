      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Layer 5 is gated by pipeline_is_implicated(): tracing costs several\nround trips, so it runs only when the query has been cleared.",
      "originalText": "Layer 5 is gated by pipeline_is_implicated(): tracing costs several\nround trips, so it runs only when the query has been cleared.",
