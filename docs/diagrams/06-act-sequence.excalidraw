      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The budget is charged before the call, so a refused change costs nothing and a failing\ntool cannot walk past the limit by retrying.",
      "originalText": "The budget is charged before the call, so a refused change costs nothing and a failing\ntool cannot walk past the limit by retrying.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
