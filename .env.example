# Copy to .env at the project root. The compose file reads it explicitly
# (env_file: ../.env), because Compose otherwise looks for .env next to the
# compose file rather than at the project root.

# --- Alfresco ---
# Used when running the Curator outside the stack; inside compose the
# service-to-service address is set for you.
ALFRESCO_BASE_URL=http://localhost:8080/alfresco
ALFRESCO_ADMIN_USER=admin
ALFRESCO_ADMIN_PASSWORD=admin

# --- Images ---
# Enterprise by default; needs `docker login quay.io`. A repository started
# without a licence runs on a 2-day trial, which is re-issued whenever the
# volumes are recreated. Mount a real licence, or pin Community instead:
#   ALFRESCO_REPO_IMAGE=alfresco/alfresco-content-repository-community:26.2.0
ALFRESCO_REPO_IMAGE=quay.io/alfresco/alfresco-content-repository:latest
# Built by compose from docker/share/Dockerfile. Override only to run the
# from-source build instead (scripts/build_share_image.ps1), which tags
# alfresco-share-curator:from-source.
#ALFRESCO_SHARE_IMAGE=alfresco-share-curator:local

# --- Browser-facing addresses (must resolve from the user's machine) ---
CURATOR_PUBLIC_URL=http://localhost:8600
SHARE_PUBLIC_URL=http://localhost:8180/share
SHARE_PUBLIC_ORIGIN=http://localhost:8180

# --- LLM provider: openai | anthropic | gemini | ollama ---
# 'openai' also targets any OpenAI-compatible gateway via OPENAI_BASE_URL.
LLM_PROVIDER=openai
# Leave LLM_MODEL empty to use the provider default
LLM_MODEL=

OPENAI_API_KEY=
# e.g. https://api.xkiro.com/v1 - omit for api.openai.com
OPENAI_BASE_URL=
# Comma separated, tried in order when the primary model is unavailable
OPENAI_FALLBACK_MODELS=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Local CPU embeddings rank suggestion chips from ACL-visible file names and
# paths only. AFTS remains the document-search authority; file bodies are not embedded.
SEMANTIC_ENABLED=true
SEMANTIC_MODEL_NAME=BAAI/bge-small-en-v1.5
SEMANTIC_MAX_DOCUMENTS=100

# LangSmith tracing (optional)
# Sends prompts and tool results to a third party. Leave false unless the
# transfer has been assessed - it is a processing route like any other.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=alfresco-curator
# LANGSMITH_API_KEY=ls__...

# --- Governance ---
# Durable, hash-chained record of instructions, egress and changes. Inside
# compose this is set to a volume; set it to a protected path elsewhere.
GOVERNANCE_LEDGER_PATH=data/governance-ledger.jsonl
GOVERNANCE_POLICY_PATH=data/governance-policy.json

# Only members of this Alfresco group can change governance in the UI.
# Replace with a dedicated group if governance should be separate from repo admins.
GOVERNANCE_ADMIN_GROUPS=GROUP_ALFRESCO_ADMINISTRATORS

# Deployment defaults. An authorized operator can override these in the
# Curator Governance panel; Use deployment defaults removes that override.
# Comma separated exact hostnames. Empty means unrestricted. A model host
# outside the list is blocked before model-backed requests run. For sovereign
# deployment, point LLM_PROVIDER at ollama and list the internal host only:
#   GOVERNANCE_ALLOWED_MODEL_HOSTS=ollama.internal
GOVERNANCE_ALLOWED_MODEL_HOSTS=

# Withhold free-text metadata (cm:title, cm:description) from the model.
# Names and paths are kept, because an answer that cannot identify the
# document is not an answer.
GOVERNANCE_MINIMISE_METADATA=false
GOVERNANCE_MUTATION_BUDGET=25
# Set false to pause all repository writes. A human must always approve each change.
GOVERNANCE_ALLOW_REPOSITORY_CHANGES=true
# Gate document/folder CRUD, restore/version, locks, comments, favorites, metadata, aspects and tags independently.
GOVERNANCE_ALLOW_CONTENT_CHANGES=true
# These gates apply to Curator's named tools; custom actions may perform similar operations.
GOVERNANCE_ALLOW_ACCESS_CHANGES=true
# Folder rules automate future content and remain individually approval-gated.
GOVERNANCE_ALLOW_FOLDER_RULES=true
GOVERNANCE_ALLOW_REPOSITORY_ACTIONS=true
